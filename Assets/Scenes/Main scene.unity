  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: -5847637345259375638, guid: 9d35e559553e3de4fbb66a9c3ebd6661, type: 2}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
